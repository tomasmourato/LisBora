    <string name="about_version">LisBora %1$s</string>
    <string name="about_summary">Rotas de bicicleta em Lisboa, calculadas no telemóvel. Não há contas nem publicidade, e a tua localização nunca sai do telemóvel. A Internet só serve para os dados novos e, no modo GIRA, para as bicicletas e docas livres.</string>
